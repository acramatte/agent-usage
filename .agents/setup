#!/usr/bin/env bash
# Prepare a fresh orb: Python deps resolved and cached so `uv run` / tests start
# without downloads. Idempotent; the warm run only re-checks the lockfile.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n== %s\n' "$*"; }
timed() { local t=$SECONDS; "$@"; echo "   (${*:1:3}: $((SECONDS - t))s)"; }

command -v uv >/dev/null || { echo "uv is missing from the orb image" >&2; exit 1; }

if [[ -f uv.lock ]]; then
  # Packaged CLI: .venv with agent-usage (editable), duckdb and pytest.
  step "uv sync"
  timed uv sync --frozen
else
  # Script layout (ingest.py / build.py with inline dependencies).
  for s in ingest.py build.py; do
    [[ -f $s ]] || continue
    step "uv sync --script $s"
    timed uv sync --script "$s"
  done
fi
